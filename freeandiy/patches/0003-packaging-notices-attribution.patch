diff --git a/packaging/env.sh b/packaging/env.sh
index 11221a5e..963b9cd3 100644
--- a/packaging/env.sh
+++ b/packaging/env.sh
@@ -48,9 +48,14 @@ warn() {
 # when building with CRAFT_FONTS_DIR).
 copy_docs() {
   local dest="$1" f
-  for f in README.md LICENSE LICENSE-MIT LICENSE-APACHE COPYRIGHT NOTICE; do
+  for f in README.md LICENSE LICENSE-MIT LICENSE-APACHE COPYRIGHT NOTICE CHANGELOG-FREEANDIY.md; do
     if [ -f "$ROOT/$f" ]; then cp "$ROOT/$f" "$dest/"; fi
   done
+  # FreeANDIY: the asset attribution, the bundled UI fonts' licences and the brand terms
+  # (Apache-2.0 4(d): NOTICE above).
+  cp "$ROOT/assets/ATTRIBUTION.md" "$dest/ATTRIBUTION.md"
+  cp "$ROOT"/freeandiy/assets/fonts/OFL-*.txt "$dest/"
+  cp "$ROOT/freeandiy/assets/brand/LICENSE-brand.txt" "$dest/LICENSE-FreeANDIY-brand.txt"
   copy_font_licences "$dest"
 }
 
